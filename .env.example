# =============================================================================
# projudi-log-offload — configuração do ambiente local
#
# Copie para .env (`cp .env.example .env` ou `make setup`) e ajuste se precisar.
# O arquivo .env NÃO é versionado (ver .gitignore).
#
# Todos os comandos assumem que o .env fica na RAIZ do repositório e que o
# compose é invocado com `--env-file .env -f infra/docker-compose.yml`
# (é o que o Makefile faz). Rodar `docker compose` de dentro de infra/ sem
# `--env-file ../.env` NÃO vai enxergar estas variáveis.
# =============================================================================

# -----------------------------------------------------------------------------
# Projeto
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=projudi-log-offload

# -----------------------------------------------------------------------------
# Versões das imagens (ver docs/decisoes.md para a justificativa de cada uma)
# -----------------------------------------------------------------------------
CLICKHOUSE_VERSION=25.8
ORACLE_VERSION=23-slim-faststart
KAFKA_VERSION=8.0.6
DEBEZIUM_VERSION=3.6.0.Final
KAFKA_UI_VERSION=v1.5.0

# Driver JDBC da Oracle embutido na imagem do Kafka Connect (baixado do Maven
# Central no build). Licença: Oracle Free Use Terms and Conditions (FUTC).
OJDBC_VERSION=23.8.0.25.04

# -----------------------------------------------------------------------------
# ClickHouse
# -----------------------------------------------------------------------------
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Usuário de aplicação (usado pelo log-writer da Frente B).
# Criado por infra/clickhouse/ddl/90_app_user.sh no primeiro start.
# O usuário `default` continua existindo, sem senha, apenas para uso interativo.
CH_APP_USER=projudi_app
CH_APP_PASSWORD=projudi_app_dev

# -----------------------------------------------------------------------------
# Oracle (gvenzl/oracle-free — CDB=FREE, PDB=FREEPDB1)
# -----------------------------------------------------------------------------
ORACLE_PORT=1521
ORACLE_SYS_PASSWORD=oracle_dev

# Dono do schema de origem (tabelas LOG, LOG_TIPO, PROC)
ORACLE_PROJUDI_PASSWORD=projudi_dev

# Usuário comum de LogMiner usado pelo Debezium (nome fixo por exigência do
# prefixo de common user do Oracle multitenant: C##)
ORACLE_DBZ_USER=c##dbzuser
ORACLE_DBZ_PASSWORD=dbz_dev

# Tamanho inicial de SGA/PGA em MB. Só tem efeito quando o banco é criado do
# zero; nas imagens *-faststart o banco já vem pronto e estes valores são
# ignorados (ver docs/decisoes.md).
ORACLE_SGA_SIZE=1536
ORACLE_PGA_SIZE=512

# Teto da Fast Recovery Area, onde os archived redo logs se acumulam.
#
# A imagem sobe SEM FRA; o init cria uma em /opt/oracle/oradata/recovery_area
# (dentro do volume) e aplica este teto. Sem isso, o Oracle arquiva em
# $ORACLE_HOME/dbs/arch — camada gravável do container, sem teto e sem
# sobreviver a uma recriação.
#
# Com ARCHIVELOG ligado (pré-requisito do CDC) o Oracle arquiva redo log
# indefinidamente e NADA os apaga sozinho. Este teto não impede o acúmulo: ele
# troca "a FRA enche o disco do host e trava a máquina" por "o Oracle suspende
# as escritas com ORA-19809", que é uma falha contida e diagnosticável.
#
# A limpeza de verdade é `make limpar-archivelog`; `make disco` avisa antes.
# Ver docs/decisoes.md, decisão 27.
ORACLE_FRA_SIZE=4G

# -----------------------------------------------------------------------------
# Kafka (KRaft, single node)
# -----------------------------------------------------------------------------
# 9092  -> listener interno, usado pelos containers (kafka:9092)
# 29092 -> listener externo, usado pelo host (localhost:29092)
KAFKA_EXTERNAL_PORT=29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# -----------------------------------------------------------------------------
# Kafka Connect / Debezium
# -----------------------------------------------------------------------------
CONNECT_PORT=8083
CONNECT_GROUP_ID=projudi-connect

# Prefixo dos tópicos gerados pelo Debezium.
# O tópico da PROC será <DEBEZIUM_TOPIC_PREFIX>.PROJUDI.PROC
# ATENÇÃO: se alterar aqui, altere também o kafka_topic_list em
# infra/clickhouse/ddl/04_cdc_kafka.sql (DDL é estático, não lê .env).
DEBEZIUM_TOPIC_PREFIX=projudi

# -----------------------------------------------------------------------------
# Kafka UI
# -----------------------------------------------------------------------------
KAFKA_UI_PORT=8080
