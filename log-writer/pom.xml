<?xml version="1.0" encoding="UTF-8"?>
<!--
  log-writer — Solução 1 (offload de log)

  Esqueleto Maven vazio, preparado para a Frente B. Nenhuma classe foi
  implementada de propósito: este módulo só define as dependências e o alvo de
  compilação, para que a implementação comece sem discussão de build.

  Java 8: é o que o Projudi usa hoje (<java.version>8</java.version> no pom do
  repositório ../projudi). O artefato precisa rodar dentro daquela aplicação,
  então não faz sentido compilar para uma versão mais nova.

  clickhouse-jdbc 0.7.2: última linha do driver que ainda suporta Java 8 — as
  versões 0.8.x em diante exigem JDK mais recente. Classificador "all" = uber
  jar com o cliente HTTP embutido e sombreado, o que evita conflito com as
  dependências já presentes no classpath do Projudi (um risco real num sistema
  legado com muitas bibliotecas antigas). Ver docs/decisoes.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>br.jus.tjgo.projudi</groupId>
    <artifactId>log-writer</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>projudi-log-writer</name>
    <description>
        Gravação dos logs de auditoria do Projudi diretamente no ClickHouse,
        preservando o formato produzido pela classe LogPs.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <java.version>8</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <clickhouse-jdbc.version>0.7.2</clickhouse-jdbc.version>
        <!--
          ojdbc8 e não ojdbc11: o ojdbc11 exige JDK 11, e este módulo compila e
          roda em Java 8. A linha 23.5.0.24.07 é a última publicada para JDK 8,
          e fala com o Oracle Free 23ai do compose sem ressalva.
          Escopo test: o driver só é necessário para o grupo de controle do
          benchmark e para o teste de integração. Nada em src/main importa
          classes da Oracle — o OracleLogSink usa só java.sql.
        -->
        <ojdbc8.version>23.5.0.24.07</ojdbc8.version>
        <!-- Mesma versão que o Projudi carrega em WEB-INF/lib. Ver a dependência. -->
        <slf4j.version>1.7.25</slf4j.version>
        <junit.version>5.11.4</junit.version>
        <surefire.version>3.2.5</surefire.version>
        <exec.plugin.version>3.5.0</exec.plugin.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
            <version>${clickhouse-jdbc.version}</version>
            <classifier>all</classifier>
            <!--
              O artefato "all" já traz tudo sombreado. Sem esta exclusão o Maven
              resolveria de novo as dependências transitivas não sombreadas,
              derrotando o propósito do uber jar.
            -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
          slf4j-api NÃO é opcional, apesar de nenhuma classe nossa importá-la.

          O uber jar "all" do clickhouse-jdbc não empacota o org.slf4j: ele traz
          apenas com/clickhouse/logging/Slf4jLogger.class, que o referencia, e o
          próprio pom do driver exclui slf4j-api das suas transitivas, esperando
          que o ambiente forneça. Com a exclusão *:* acima, nada fornecia, e o
          <clinit> de com.clickhouse.jdbc.ClickHouseDriver morria com
          NoClassDefFoundError: org/slf4j/LoggerFactory. O DriverManager engole
          esse erro dentro do laço de carga do ServiceLoader, e o sintoma que
          chega ao usuário é "No suitable driver found for jdbc:ch://…" —
          apontando para a URL quando o problema é uma classe ausente.

          Escopo `provided`, e não `compile`, por dois motivos:
            - o Projudi JÁ tem org.slf4j:slf4j-api:1.7.25 no WEB-INF/lib, então
              exportar a dependência arriscaria duas versões no mesmo classpath,
              que é exatamente o que a decisão 14 quer evitar;
            - `provided` está presente na compilação e nos testes deste módulo,
              que é onde o driver precisa carregar sozinho.

          Versão fixada na mesma que o Projudi usa, para que o teste exercite o
          que a produção vai fornecer.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <version>${ojdbc8.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!--
                      `mvn test` roda só os testes unitários e não pode depender
                      de banco nenhum. O teste de integração real vive na classe
                      *IT e se habilita sozinho quando a propriedade
                      clickhouse.integracao=true é passada (JUnit 5
                      @EnabledIfSystemProperty); sem ela, é pulado, não falha.
                      A propriedade é repassada à JVM de teste aqui.
                    -->
                    <systemPropertyVariables>
                        <clickhouse.integracao>${clickhouse.integracao}</clickhouse.integracao>
                        <oracle.integracao>${oracle.integracao}</oracle.integracao>
                    </systemPropertyVariables>
                    <!--
                      As classes *IT não entram no padrão padrão do surefire
                      (*Test, Test*, *Tests, *TestCase). Sem incluí-las aqui,
                      passar -Dclickhouse.integracao=true não teria efeito
                      nenhum: a classe simplesmente não seria executada, e o
                      build ficaria verde sem ter testado nada.
                    -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- Os payloads reais têm acentuação; sem isto, o teste de
                         integridade byte a byte falharia pelo motivo errado. -->
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

            <!--
              Harness de benchmark. Roda com:
                mvn -q test-compile exec:java@bench -Dbench.n=10000 -Dbench.lote=500
              classpathScope=test porque o harness mora em src/test/java, junto
              com o driver Oracle do grupo de controle.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <executions>
                    <execution>
                        <id>bench</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>br.jus.tjgo.projudi.logwriter.bench.BenchmarkHarness</mainClass>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Valores padrão das flags de integração. Ficam vazios para que
          @EnabledIfSystemProperty não case e os testes de integração sejam
          pulados no `mvn test` normal.
        -->
        <profile>
            <id>padrao-sem-integracao</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <clickhouse.integracao>false</clickhouse.integracao>
                <oracle.integracao>false</oracle.integracao>
            </properties>
        </profile>
    </profiles>

</project>
